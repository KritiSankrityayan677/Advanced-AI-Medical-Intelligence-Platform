# Groq API Configuration
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: specify the LLM model (default: openai/gpt-oss-20b)
LLM_MODEL=openai/gpt-oss-20b

# Optional: specify the LLM provider (default: groq)
LLM_PROVIDER=groq

# Optional: point the Streamlit frontend at a local backend instead of the
# deployed Railway API (default: https://neurovision-ai.up.railway.app)
# MEDICAL_AI_API_URL=http://127.0.0.1:8000
